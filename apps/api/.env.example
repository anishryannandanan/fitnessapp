# Server
PORT=3000
NODE_ENV=development

# Frontend origin allowed for CORS (the Vite web app)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL="postgresql://fitcore:fitcore@localhost:5432/fitcore?schema=public"

# Auth
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed owner credentials (used by prisma/seed.ts)
SEED_OWNER_EMAIL=owner@fitnessworld.in
SEED_OWNER_PASSWORD=Owner@123
SEED_DEFAULT_PASSWORD=Staff@123
