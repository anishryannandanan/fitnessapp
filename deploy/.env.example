# Copy to deploy/.env and fill in. Never commit the real .env.

# Public URL of your subdomain (used for CORS + baked into the web build as VITE_API_URL).
PUBLIC_URL=https://gym.yourdomain.com

# Port published on the VPS localhost for Caddy to reverse-proxy to.
WEB_PORT=8090

# Postgres (kept inside the stack; not exposed publicly)
POSTGRES_USER=fitcore
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=fitcore

# Auth — MUST be a long random string in production (>= 32 chars)
JWT_SECRET=CHANGE_ME_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed the single business + demo users on first boot. Set to false after first deploy.
SEED_ON_START=true
SEED_OWNER_EMAIL=owner@fitnessworld.in
SEED_OWNER_PASSWORD=CHANGE_ME_owner_password
SEED_DEFAULT_PASSWORD=CHANGE_ME_staff_password
