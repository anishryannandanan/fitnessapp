# FitCore API (NestJS + Fastify + Prisma). Single-stage image for a VPS.
FROM node:22-bookworm-slim

# Prisma needs OpenSSL at build and runtime.
RUN apt-get update -y && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@10
WORKDIR /app

# Install deps (cached layer)
COPY apps/api/package.json apps/api/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Prisma client + app build
COPY apps/api/prisma ./prisma
RUN pnpm prisma generate
COPY apps/api/ ./
RUN pnpm build

ENV NODE_ENV=production
EXPOSE 3000

# On start: sync schema, optionally seed, then run the server.
CMD ["sh", "-c", "pnpm prisma db push --skip-generate && ([ \"$SEED_ON_START\" = \"true\" ] && pnpm seed || true) && node dist/main.js"]
