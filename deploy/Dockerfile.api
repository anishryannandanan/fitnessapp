FROM node:22-alpine
WORKDIR /app

RUN npm install -g pnpm

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN npx prisma -v || true

COPY prisma ./prisma
RUN npx prisma generate

COPY . .
RUN npx nest build

EXPOSE 3000

CMD ["sh", "-c", "npx prisma db push --accept-data-loss && npx ts-node prisma/seed.ts 2>/dev/null || true && npx ts-node prisma/seed-demo-data.ts 2>/dev/null || true; node dist/main.js"]
